{
    "experimentalServices": {
        "frontend": {
            "root": "frontend",
            "routePrefix": "/",
            "framework": "vite",
            "buildCommand": "npm run build",
            "installCommand": "npm install"
        },
        "backend": {
            "root": "backend",
            "routePrefix": "/_/backend",
            "framework": "python",
            "buildCommand": "pip install -r requirements.txt",
            "entrypoint": "run.py"
        }
    }
}
